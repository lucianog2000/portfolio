---
import Layout from "../layouts/Layout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { projects } from "../data/projects";
---

<Layout title="Work" description="Products I'm building, web3 projects, and hackathon builds.">
  <h1 class="font-display text-[clamp(2.2rem,6vw,5rem)] font-[750] lowercase leading-none tracking-[-0.045em]">work</h1>
  <p class="mt-3 max-w-[60ch] text-muted">
    Products I'm building, then web3 projects and hackathon builds. Day-job work at Personal is private, so it lives on
    the{" "}
    <a class="link" href="/about">
      about
    </a>{" "}
    page as a summary.
  </p>

  {projects.map((p, i) => (
    <section id={p.slug} class="mt-20 scroll-mt-10">
      <header class="flex items-end gap-4">
        <span class="font-display text-[clamp(1.8rem,4vw,3.2rem)] font-[300] leading-none text-faint">
          {String(i + 1).padStart(2, "0")}
        </span>
        <div>
          <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.8rem)] font-[650] lowercase leading-none tracking-[-0.035em]">
            {p.name}
          </h2>
          <p class="mt-1 text-[11px] text-muted">{p.context}</p>
        </div>
      </header>

      <div class="strip -mx-5 mt-6 flex gap-4 overflow-x-auto px-5 pb-2 sm:-mx-10 sm:px-10">
        <ProjectVisual project={p} />

        <article class="flex w-[min(88vw,420px)] shrink-0 flex-col rounded-[28px] bg-surface/80 p-6 ring-1 ring-white/5 sm:p-8">
          <h3 class="label">my part · {p.role.toLowerCase()}</h3>
          <ul class="mt-3 space-y-2.5">
            {p.contributions.map((c) => (
              <li class="flex gap-3 text-pretty">
                <span class="text-phosphor">›</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>

          <h3 class="label mt-8">stack</h3>
          <p class="mt-3 text-muted">{p.stack.join(" · ")}</p>

          <div class="mt-auto flex flex-wrap gap-2 pt-8">
            {p.links.map((l) => (
              <a
                href={l.url}
                target="_blank"
                rel="noopener"
                title={l.note}
                class="rounded-full bg-surface-2 px-4 py-2 text-[11px] tracking-[0.08em] text-text ring-1 ring-white/5 transition hover:bg-accent hover:text-white"
              >
                {l.label} ↗{l.note && <span class="ml-1 text-faint">· {l.note}</span>}
              </a>
            ))}
          </div>
        </article>
      </div>
    </section>
  ))}
</Layout>
