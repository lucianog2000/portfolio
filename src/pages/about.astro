---
import Layout from "../layouts/Layout.astro";
import { experience, hackathons, education, certifications, learning, onchain, languages } from "../data/profile";
import { radars, scale } from "../data/skills";
import Radar from "../components/Radar.astro";
---

<Layout title="About">
  <h1 class="font-display text-[clamp(2.2rem,6vw,5rem)] font-[750] lowercase leading-none tracking-[-0.045em]">
    about
  </h1>

  {experience.map((job, i) => (
    <section class="mt-14">
      <div class="flex items-baseline gap-4">
        <span class="font-display text-[clamp(1.8rem,4vw,3.2rem)] font-[300] leading-none text-faint">
          {String(i).padStart(2, "0")}
        </span>
        <div>
          <h2 class="font-display text-[clamp(1.4rem,3vw,2.4rem)] font-[650] lowercase leading-tight tracking-[-0.03em]">
            {job.company}
          </h2>
          <p class="text-muted">
            {job.role} · {job.period}
            {job.url && (
              <>
                {" · "}
                <a class="link" href={job.url} target="_blank" rel="noopener">
                  {job.url.replace("https://", "")}
                </a>
              </>
            )}
          </p>
        </div>
      </div>

      <div class="mt-8 grid gap-10 lg:grid-cols-3">
        <div>
          <h3 class="label">overview</h3>
          <p class="mt-3 text-pretty">{job.summary}</p>
          {job.stats.length > 0 && (
            <dl class="mt-6 grid grid-cols-3 gap-3">
              {job.stats.map((s) => (
                <div class="rounded-2xl bg-surface/70 p-3 ring-1 ring-white/5">
                  <dt class="order-2 text-[11px] text-muted">{s.label}</dt>
                  <dd class="font-display text-2xl font-[650] text-text">{s.value}</dd>
                </div>
              ))}
            </dl>
          )}
          <h3 class="label mt-8">stack</h3>
          <p class="mt-3 text-muted">{job.stack.join(" · ")}</p>
        </div>

        <div class="lg:col-span-2">
          <h3 class="label">what I worked on</h3>
          <ul class="mt-1">
            {job.highlights.map((h) => (
              <li id={h.area} class="grid scroll-mt-10 grid-cols-[100px_1fr] gap-4 border-b border-divider/50 py-3">
                <span class="text-phosphor">{h.area}</span>
                <span class="text-pretty">{h.text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  ))}

  <section class="mt-20">
    <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
      <h2 class="font-display text-[clamp(1.4rem,3vw,2.4rem)] font-[650] lowercase leading-tight tracking-[-0.03em]">
        skills, with receipts
      </h2>
      <p class="text-[11px] text-faint">
        levels follow evidence, not opinion ·{" "}
        {scale.map((s, i) => (
          <span>
            <span class="text-muted">{s.level}</span> {s.label}
            {i < scale.length - 1 ? " · " : ""}
          </span>
        ))}
      </p>
    </div>
    <div class="mt-8 grid gap-14 lg:grid-cols-2">
      {radars.map((r) => (
        <Radar radar={r} />
      ))}
    </div>
  </section>

  <section class="mt-20 grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <h2 class="label">hackathons &amp; competitions</h2>
      <ul>
        {hackathons.map((h) => (
          <li class="grid gap-1 border-b border-divider/50 py-3 sm:grid-cols-[260px_1fr] sm:gap-4">
            <span class="text-muted">{h.name}</span>
            <span>
              <a class="link" href={h.url} target="_blank" rel="noopener">
                {h.project}
              </a>
              {h.result && (
                <span class="ml-2 rounded-full bg-accent/20 px-2 py-0.5 text-[11px] text-accent-glow">{h.result}</span>
              )}
              <span class="block text-muted">{h.text}</span>
            </span>
          </li>
        ))}
      </ul>

      <h2 class="label mt-10">{onchain.title}</h2>
      <p class="mt-3 max-w-[70ch] text-pretty text-muted">{onchain.text}</p>
    </div>

    <div>
      <h2 class="label">currently learning</h2>
      <ul class="mb-10">
        {learning.map((l) => (
          <li class="border-b border-divider/50 py-3">
            <span class="block">
              {l.title}
              <span
                class="ml-2 inline-block size-1.5 animate-pulse rounded-full bg-phosphor align-middle"
                aria-hidden="true"
              />
            </span>
            <a class="link text-muted" href={l.url} target="_blank" rel="noopener">
              {l.place}
            </a>
            <span class="block text-muted">{l.text}</span>
          </li>
        ))}
      </ul>

      <h2 class="label">education</h2>
      <ul>
        {[...education, ...certifications].map((e) => (
          <li class="border-b border-divider/50 py-3">
            <span class="block">{e.title}</span>
            <span class="text-muted">
              {e.place} · {e.period}
            </span>
          </li>
        ))}
      </ul>

      <h2 class="label mt-10">languages</h2>
      <ul>
        {languages.map((l) => (
          <li class="border-b border-divider/50 py-3">
            <span class="block">{l.name}</span>
            <span class="text-muted">{l.level}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
